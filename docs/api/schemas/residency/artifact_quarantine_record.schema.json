{
  "$defs": {
    "reason": {
      "$ref": "../residency.reason/1.0"
    }
  },
  "$id": "residency.artifact_quarantine_record/1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "attempt_in_progress"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "current_attempt_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "cleanup_pending",
              "attempt_in_progress"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "expires_at": {
            "type": "null"
          }
        },
        "required": [
          "expires_at"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "cleared"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "expires_at": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "expires_at"
        ]
      }
    },
    {
      "x-residency-derived-by": {
        "field": "resolution_intent",
        "selected_by": [
          "origin",
          "resolution_evidence"
        ]
      }
    }
  ],
  "properties": {
    "artifact_baseline": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "artifact_generation": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[\\u0021-\\u007e]+$",
              "type": "string",
              "x-max-utf8-bytes": 128
            },
            "digest": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[\\u0021-\\u007e]+$",
              "type": "string",
              "x-max-utf8-bytes": 128
            },
            "state": {
              "const": "present"
            }
          },
          "required": [
            "state",
            "artifact_generation",
            "digest"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "artifact_store_generation": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[\\u0021-\\u007e]+$",
              "type": "string",
              "x-max-utf8-bytes": 128
            },
            "state": {
              "const": "absent"
            }
          },
          "required": [
            "state",
            "artifact_store_generation"
          ],
          "type": "object"
        }
      ]
    },
    "artifact_disposition": {
      "enum": [
        "unknown",
        "baseline_present_verified",
        "baseline_absent_verified",
        "target_published",
        "target_deleted"
      ],
      "maxLength": 25,
      "minLength": 1,
      "type": "string"
    },
    "artifact_quarantine_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[\\u0021-\\u007e]+$",
      "type": "string",
      "x-max-utf8-bytes": 128
    },
    "artifact_scope_key": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[\\u0021-\\u007e]+$",
      "type": "string",
      "x-max-utf8-bytes": 128
    },
    "artifact_target": {
      "enum": [
        "preserve_baseline",
        "publish_target",
        "delete_target"
      ],
      "maxLength": 17,
      "minLength": 1,
      "type": "string"
    },
    "cause": {
      "$ref": "#/$defs/reason"
    },
    "coordinator_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[\\u0021-\\u007e]+$",
      "type": "string",
      "x-max-utf8-bytes": 128
    },
    "current_attempt_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[\\u0021-\\u007e]+$",
      "type": "string",
      "x-max-utf8-bytes": 128
    },
    "etag": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^\"[^\"\\u0000-\\u001f]{1,124}\"$",
      "type": "string",
      "x-strong-etag": true
    },
    "expires_at": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "format": "date-time",
          "type": "string"
        }
      ]
    },
    "identity_scopes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "baseline": {
            "oneOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "etag": {
                    "maxLength": 128,
                    "minLength": 1,
                    "pattern": "^[\\u0021-\\u007e]+$",
                    "type": "string",
                    "x-max-utf8-bytes": 128
                  },
                  "identity_generation": {
                    "maxLength": 128,
                    "minLength": 1,
                    "pattern": "^[\\u0021-\\u007e]+$",
                    "type": "string",
                    "x-max-utf8-bytes": 128
                  },
                  "state": {
                    "const": "present"
                  }
                },
                "required": [
                  "state",
                  "identity_generation",
                  "etag"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "absence_validator": {
                    "maxLength": 128,
                    "minLength": 1,
                    "pattern": "^[\\u0021-\\u007e]+$",
                    "type": "string",
                    "x-max-utf8-bytes": 128
                  },
                  "identity_root_generation": {
                    "maxLength": 128,
                    "minLength": 1,
                    "pattern": "^[\\u0021-\\u007e]+$",
                    "type": "string",
                    "x-max-utf8-bytes": 128
                  },
                  "state": {
                    "const": "absent"
                  }
                },
                "required": [
                  "state",
                  "identity_root_generation",
                  "absence_validator"
                ],
                "type": "object"
              }
            ]
          },
          "disposition": {
            "enum": [
              "unknown",
              "baseline_present_verified",
              "baseline_absent_verified",
              "target_published",
              "target_deleted"
            ],
            "maxLength": 25,
            "minLength": 1,
            "type": "string"
          },
          "scope_key": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[\\u0021-\\u007e]+$",
            "type": "string",
            "x-max-utf8-bytes": 128
          },
          "target": {
            "enum": [
              "preserve_baseline",
              "publish_target",
              "delete_target"
            ],
            "maxLength": 17,
            "minLength": 1,
            "type": "string"
          },
          "target_generation": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[\\u0021-\\u007e]+$",
            "type": "string",
            "x-max-utf8-bytes": 128
          }
        },
        "required": [
          "scope_key",
          "target",
          "baseline",
          "disposition"
        ],
        "type": "object"
      },
      "maxItems": 2,
      "minItems": 1,
      "type": "array",
      "x-canonical-order": true
    },
    "maximum_plausible_states": {
      "type": "object"
    },
    "model_scope_key": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[\\u0021-\\u007e]+$",
      "type": "string",
      "x-max-utf8-bytes": 128
    },
    "native_writer_references": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[\\u0021-\\u007e]+$",
        "type": "string",
        "x-max-utf8-bytes": 128
      },
      "maxItems": 32,
      "type": "array"
    },
    "next_eligible_retry": {
      "format": "date-time",
      "type": "string"
    },
    "origin": {
      "enum": [
        "load_acquisition",
        "model_delete",
        "staged_import_abort",
        "staged_import_publish",
        "staged_import_adopt"
      ],
      "maxLength": 21,
      "minLength": 1,
      "type": "string"
    },
    "record_generation": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[\\u0021-\\u007e]+$",
      "type": "string",
      "x-max-utf8-bytes": 128
    },
    "resolution_evidence": {
      "additionalProperties": false,
      "properties": {
        "manifest_generation": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[\\u0021-\\u007e]+$",
          "type": "string",
          "x-max-utf8-bytes": 128
        },
        "marker_generation": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[\\u0021-\\u007e]+$",
          "type": "string",
          "x-max-utf8-bytes": 128
        },
        "marker_kind": {
          "enum": [
            "none",
            "artifact_publish_irreversible",
            "model_delete_requested"
          ],
          "maxLength": 29,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "marker_kind",
        "marker_generation"
      ],
      "type": "object"
    },
    "resolution_intent": {
      "enum": [
        "preserve_baseline",
        "complete_publish",
        "complete_delete"
      ],
      "maxLength": 17,
      "minLength": 1,
      "type": "string"
    },
    "schema": {
      "const": "residency.explanation/1.0"
    },
    "session_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[\\u0021-\\u007e]+$",
      "type": "string",
      "x-max-utf8-bytes": 128
    },
    "staging_disposition": {
      "enum": [
        "not_applicable",
        "unknown",
        "removed"
      ],
      "maxLength": 14,
      "minLength": 1,
      "type": "string"
    },
    "state": {
      "enum": [
        "cleanup_pending",
        "attempt_in_progress",
        "cleared"
      ],
      "maxLength": 19,
      "minLength": 1,
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "artifact_quarantine_id",
    "record_generation",
    "etag",
    "state",
    "origin",
    "resolution_intent",
    "resolution_evidence",
    "model_scope_key",
    "artifact_scope_key",
    "identity_scopes",
    "artifact_baseline",
    "artifact_target",
    "artifact_disposition",
    "staging_disposition",
    "native_writer_references",
    "maximum_plausible_states",
    "next_eligible_retry",
    "updated_at",
    "expires_at"
  ],
  "title": "Artifact Quarantine Record",
  "type": "object",
  "x-residency-required-keywords": [
    "x-max-utf8-bytes",
    "x-nfc"
  ]
}
