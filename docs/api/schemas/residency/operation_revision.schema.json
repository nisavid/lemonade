  "$id": "residency.operation_revision/1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "const": "terminal"
          }
        },
        "required": [
          "phase"
        ]
      },
      "then": {
        "allOf": [
          {
            "properties": {
              "primary_reason_code": {
                "not": {
                  "type": "null"
                }
              },
              "terminal_outcome": {
                "not": {
                  "type": "null"
                }
              }
            },
            "required": [
              "terminal_outcome",
              "primary_reason_code"
            ]
          },
          {
            "properties": {
              "reasons": {
                "minItems": 1
              }
            },
            "required": [
              "reasons"
            ]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "not": {
              "const": "terminal"
            }
          }
        },
        "required": [
          "phase"
        ]
      },
      "then": {
        "properties": {
          "terminal_outcome": {
            "type": "null"
          }
        },
        "required": [
          "terminal_outcome"
        ]
      }
    },
    {
      "x-residency-assert": {
        "equals_path": "reasons[0].code",
        "field": "primary_reason_code"
      }
    }
  ],
  "properties": {
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "expires_at": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "format": "date-time",
          "type": "string"
        }
      ]
    },
    "explanation_revision": {
      "maximum": 18446744073709551615,
      "minimum": 0,
      "type": "integer"
    },
    "family": {
      "enum": [
        "resource_lifecycle",
        "resident_state"
      ],
      "maxLength": 18,
      "minLength": 1,
      "type": "string"
    },
    "forgotten_at": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "format": "date-time",
          "type": "string"
        }
      ]
    },
    "operation_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[\\u0021-\\u007e]+$",
      "type": "string",
      "x-max-utf8-bytes": 128
    },
    "operation_kind": {
      "enum": [
        "admission",
        "explicit_unload",
        "force_unload",
        "pressure_reclamation",
        "startup_load",
        "service_termination",
        "dead_backend_pruning",
        "same_epoch_recovery_cleanup",
        "prior_epoch_owner_cleanup",
        "artifact_scope_recovery_cleanup",
        "saved_pin_mutation",
        "runtime_pin_mutation",
        "legacy_pin_batch",
        "resident_state_recovery_cleanup"
      ],
      "maxLength": 31,
      "minLength": 1,
      "type": "string"
    },
    "phase": {
      "enum": [
        "evaluating",
        "waiting_for_evidence",
        "waiting_for_in_use",
        "reserved",
        "executing",
        "closing",
        "recovery_required",
        "terminal"
      ],
      "maxLength": 20,
      "minLength": 1,
      "type": "string"
    },
    "plan_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[\\u0021-\\u007e]+$",
          "type": "string",
          "x-max-utf8-bytes": 128
        }
      ]
    },
    "primary_reason_code": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      ]
    },
    "reasons": {
      "items": {
        "$ref": "#/$defs/reason"
      },
      "maxItems": 16,
      "type": "array",
      "x-canonical-order": true
    },
    "retention_state": {
      "enum": [
        "detail",
        "tombstone",
        "forgotten"
      ],
      "maxLength": 9,
      "minLength": 1,
      "type": "string"
    },
    "schema": {
      "const": "residency.explanation/1.0"
    },
    "terminal_outcome": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "succeeded",
            "refused",
            "failed",
            "cancelled",
            "superseded",
            "partially_succeeded",
            "quarantined"
          ],
          "maxLength": 19,
          "minLength": 1,
          "type": "string"
        }
      ]
    },
    "updated_at": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "operation_id",
    "plan_id",
    "family",
    "operation_kind",
    "phase",
    "terminal_outcome",
    "explanation_revision",
    "primary_reason_code",
    "reasons",
    "created_at",
    "updated_at",
    "expires_at",
    "forgotten_at",
    "retention_state"
  ],
  "title": "Operation Revision",
