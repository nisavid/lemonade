                    "residency_artifact_writer_failed",
                    "residency_artifact_writer_superseded_by_model_delete",
                    "residency_artifact_import_expired",
                    "residency_artifact_import_invalid",
                    "residency_artifact_import_failed",
                    "residency_artifact_import_cleanup_incomplete"
                  ]
                },
                {
                  "not": {
                    "enum": [
                      "residency_operation_succeeded",
                      "residency_persistence_failed",
                      "residency_explanation_storage_unavailable",
                      "residency_authority_persistence_failed",
                      "residency_authority_storage_unavailable",
