                  }
                }
              ]
            }
          },
          "required": [
            "code"
          ],
          "type": "object"
        }
      ],
      "x-reason-envelope": "artifact_writer_job_revision"
    }
  },
  "$id": "residency.artifact_writer_job_revision/1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "normalized_state": {
            "const": "terminal_success"
          }
        },
        "required": [
          "normalized_state"
        ]
      },
      "then": {
        "allOf": [
          {
            "properties": {
              "reasons": {
                "maxItems": 0
              }
            },
            "required": [
              "reasons"
            ]
          },
          {
            "properties": {
              "cause": {
                "const": "none"
              },
              "resume_allowed": {
                "const": false
              }
            },
            "required": [
              "cause",
              "resume_allowed"
            ]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "normalized_state": {
            "enum": [
              "terminal_failed",
              "terminal_superseded"
            ]
          }
        },
        "required": [
          "normalized_state"
        ]
      },
      "then": {
        "properties": {
          "reasons": {
            "minItems": 1
          }
        },
        "required": [
          "reasons"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "cause": {
            "const": "staged_import_cleanup_incomplete"
          }
        },
        "required": [
          "cause"
        ]
      },
      "then": {
        "allOf": [
          {
            "required": [
              "artifact_quarantine_record_id"
            ]
          },
          {
            "properties": {
              "effect_disposition": {
                "const": "ambiguous"
              },
              "publish_disposition": {
                "const": "unknown"
              }
            },
            "required": [
              "effect_disposition",
              "publish_disposition"
            ]
          }
        ]
      }
    }
  ],
  "properties": {
    "artifact_quarantine_record_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[\\u0021-\\u007e]+$",
      "type": "string",
      "x-max-utf8-bytes": 128
    },
    "artifact_scope_key": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[\\u0021-\\u007e]+$",
      "type": "string",
      "x-max-utf8-bytes": 128
    },
    "cause": {
      "enum": [
        "none",
        "native_failed",
        "client_cancelled",
        "superseded_by_model_delete",
        "staged_import_expired",
        "staged_import_validation_failed",
        "staged_import_failed",
        "staged_import_cleanup_incomplete"
      ],
      "maxLength": 32,
      "minLength": 1,
      "type": "string"
    },
    "coordinator_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[\\u0021-\\u007e]+$",
      "type": "string",
      "x-max-utf8-bytes": 128
    },
    "effect_disposition": {
      "enum": [
        "no_effect",
        "verified_effect",
        "ambiguous"
      ],
      "maxLength": 15,
      "minLength": 1,
      "type": "string"
    },
    "native_family": {
      "enum": [
        "generic_job",
        "download_job",
        "ollama_pull_stream",
        "public_sse_writer",
        "public_blocking_writer",
        "staged_import_writer"
      ],
      "maxLength": 22,
      "minLength": 1,
      "type": "string"
    },
    "native_state_ref": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[\\u0021-\\u007e]+$",
      "type": "string",
      "x-max-utf8-bytes": 128
    },
    "normalized_state": {
      "enum": [
        "active",
        "terminal_success",
        "terminal_superseded",
        "terminal_failed"
      ],
      "maxLength": 19,
      "minLength": 1,
      "type": "string"
    },
    "publish_disposition": {
      "enum": [
        "prevented",
        "published_expected",
        "unknown"
      ],
      "maxLength": 18,
      "minLength": 1,
      "type": "string"
    },
    "reasons": {
      "items": {
        "$ref": "#/$defs/reason"
      },
      "maxItems": 16,
      "type": "array",
      "x-canonical-order": true
    },
    "resume_allowed": {
      "type": "boolean"
    },
    "schema": {
      "const": "residency.explanation/1.0"
    },
    "session_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[\\u0021-\\u007e]+$",
      "type": "string",
      "x-max-utf8-bytes": 128
    },
    "writer_generation": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[\\u0021-\\u007e]+$",
      "type": "string",
      "x-max-utf8-bytes": 128
    },
    "writer_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[\\u0021-\\u007e]+$",
      "type": "string",
      "x-max-utf8-bytes": 128
    }
  },
  "required": [
    "schema",
    "writer_id",
    "writer_generation",
    "native_family",
    "native_state_ref",
    "artifact_scope_key",
    "normalized_state",
    "cause",
    "resume_allowed",
    "effect_disposition",
    "publish_disposition",
    "reasons"
  ],
  "title": "Artifact Writer Job Revision",
  "type": "object",
  "x-residency-required-keywords": [
    "x-max-utf8-bytes",
    "x-nfc"
  ]
}
