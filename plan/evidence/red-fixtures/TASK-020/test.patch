+def run_stage(
+    command: list[str],
+    *,
+    workdir: Path,
+    failed: str,
+    timed_out: str,
+    unavailable: str,
+    runner=subprocess.run,
+) -> str | None:
+    try:
+        completed = runner(
+            command,
+            cwd=workdir,
+            check=False,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            timeout=PROCESS_TIMEOUT_SECONDS,
+        )
+    except subprocess.TimeoutExpired:
+        return timed_out
+    except (OSError, UnicodeError):
+        return unavailable
+    if completed.returncode != 0:
+        return failed
+    return None
