+        if constructor.search(class_body) is None:
+            continue
+        for instance in re.finditer(
+            rf"\b{re.escape(class_name)}\s+(?P<name>[A-Za-z_]\w*)\s*"
+            r"[({]\s*directory_fd\s*[)}]",
