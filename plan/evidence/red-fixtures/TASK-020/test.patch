+        request_initializer = ""
+        if request_name is not None:
+            declaration = re.search(
+                rf"\b(?:const\s+)?(?:auto|std::size_t|DWORD|std::uint32_t)\s+"
+                rf"{re.escape(request_name.group(0))}\s*=\s*(?P<value>[^;]+);",
