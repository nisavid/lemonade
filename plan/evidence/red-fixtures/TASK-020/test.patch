+        }
+        return {::lemon::residency::detail::DurableFileResult{
+                    ::lemon::residency::detail::DurableFileStatus::Succeeded,
+                    {}},
+                written};
+        """,
+    )
+    if actual != expected:
+        raise AssertionError(f"{label} Windows write override shape drifted")
