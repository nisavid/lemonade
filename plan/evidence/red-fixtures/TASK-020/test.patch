+    NativeDirectory exact("task020-native-read-exact-cap");
+    static_cast<void>(create_native(exact.path(), chain));
+    append_bytes(exact.path() / "journal.jsonl", "x");
+    auto exact_journal = DurableJournal::native(exact.path(), limits);
