+def yaml_execution_metadata_is_live(metadata: dict[str, str]) -> bool:
+    if "if" in metadata:
+        return False
+    continue_on_error = metadata.get("continue-on-error")
+    return (
+        continue_on_error is None or continue_on_error.strip("'\"").lower() == "false"
+    )
