+        return run_stage(
+            [str(output), "--race-verify", str(authority), str(floor)],
+            workdir=output.parent,
+            failed=CONTRACT_ASSERTION_FAILED,
+            timed_out=EXECUTION_TIMED_OUT,
+            unavailable=EXECUTABLE_UNAVAILABLE,
+        )
