+def strip_inactive_cpp_blocks(source: str) -> str:
+    pattern = re.compile(r"(?ms)^\s*#\s*if\s+(?:0|false)\b.*?^\s*#\s*endif\b[^\n]*")
+    previous = None
+    while source != previous:
+        previous = source
+        source = pattern.sub(lambda match: "\n" * match.group(0).count("\n"), source)
+    return source
