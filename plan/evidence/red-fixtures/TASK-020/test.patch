+def require_compiler_selection_contract() -> None:
+    absolute_wrapper = "/fixture/toolchains/task020/c++ wrapper"
+    fallback = "c++"
+    lookups: list[str] = []
+
+    def fake_which(command: str) -> str | None:
+        lookups.append(command)
+        if command == absolute_wrapper:
