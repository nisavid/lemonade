+def compiler_command(
+    compiler: str, source: str, output: str, platform_id: str
+) -> list[str]:
+    if platform_id == "windows":
+        return [
+            compiler,
+            "/nologo",
+            "/std:c++17",
+            "/W4",
+            "/WX",
+            "/EHsc",
+            source,
+            f"/Fe:{output}",
+        ]
+    return [
+        compiler,
+        "-std=c++17",
+        "-Wall",
+        "-Wextra",
+        "-Werror",
+        "-pedantic",
+        "-pthread",
+        source,
+        "-o",
+        output,
+    ]
