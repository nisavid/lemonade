+def require_result_identity(repo_root: Path, result: dict) -> None:
+    require(
+        set(result)
+        == {
+            "schema",
+            "task_id",
+            "prototype_id",
+            "task_base_commit",
+            "source",
+            "outcome",
+            "runtime_authority",
+            "fallback_state",
+            "observations",
+            "claims",
+        },
+        "TASK-016 result fields are not closed",
+    )
+    require(
+        result["schema"] == "residency_prototype_result/v1",
+        "result schema changed",
+    )
+    require(result["task_id"] == TASK_ID, "TASK-016 result changed its task ID")
+    require(
+        result["task_base_commit"] == TASK_BASE,
+        "TASK-016 result changed its task base",
+    )
+    require(
+        result["prototype_id"] == PROTOTYPE_ID,
+        "TASK-016 result changed its prototype identity",
+    )
+    source = repo_root / SOURCE_PATH
+    require(
+        result["source"]
+        == {
+            "path": SOURCE_PATH,
+            "sha256": EXPECTED_SOURCE_SHA256,
+        },
+        "TASK-016 result does not bind its source bytes",
+    )
+    require(
+        hashlib.sha256(source.read_bytes()).hexdigest() == EXPECTED_SOURCE_SHA256,
+        "TASK-016 source differs from the audited red-seam bytes",
+    )
+    require(result["outcome"] == "mixed", "TASK-016 result must remain mixed")
+    require(
+        result["runtime_authority"] == "none",
+        "TASK-016 prototype granted runtime authority",
+    )
+    require(
+        result["fallback_state"] == {"authority": "legacy_runtime", "status": "active"},
+        "TASK-016 prototype changed the active fallback authority",
+    )
