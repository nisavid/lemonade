+def require_inventory_contract(repo_root: Path) -> dict:
+    path = repo_root / "docs/research/portable-residency-capability-inventory.json"
+    inventory = parse_json_object(path.read_bytes())
+    require(
+        inventory.get("runtime_binding_kinds") == RUNTIME_BINDING_NAMES,
+        "inventory changed the closed runtime-binding vocabulary",
+    )
+    cells = inventory.get("exact_cells")
+    require(type(cells) is list, "inventory exact-cell registry is unavailable")
+    cell_by_id = {
+        cell.get("cell_id"): cell
+        for cell in cells
+        if type(cell) is dict and type(cell.get("cell_id")) is str
+    }
+    require(len(cell_by_id) == len(cells), "inventory exact-cell IDs are not unique")
+    require(
+        set(cell_by_id) == set(UNIT_IDS),
+        "inventory changed the TASK-016 exact-cell closure",
+    )
+    for unit_id in UNIT_IDS:
+        require(
+            cell_by_id[unit_id].get("runtime_bindings") == RUNTIME_BINDING_NAMES,
+            f"{unit_id} changed its runtime-binding closure",
+        )
+
+    fallback_bindings = []
+    fallback_rows = []
+    for label, unit_id, fallback_slot in FALLBACK_SLOTS:
+        fallbacks = cell_by_id[unit_id].get("fallbacks")
+        require(type(fallbacks) is dict, f"{unit_id} fallbacks are unavailable")
+        fallback_id = fallbacks.get(fallback_slot)
+        require(
+            type(fallback_id) is str and fallback_id,
+            f"{unit_id} omits {fallback_slot}",
+        )
+        fallback_rows.append(f"fallback_binding.{label}={fallback_id}")
+    for unit_id in UNIT_IDS:
+        fallbacks = cell_by_id[unit_id]["fallbacks"]
+        fallback_bindings.append({"unit_id": unit_id, "fallbacks": fallbacks})
+    require(
+        sum(len(binding["fallbacks"]) for binding in fallback_bindings)
+        == len(FALLBACK_SLOTS),
+        "TASK-016 inventory fallback closure changed",
