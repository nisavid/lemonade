+def _git(*args: str) -> subprocess.CompletedProcess[bytes]:
+    return subprocess.run(
+        ["git", *args],
+        cwd=REPO_ROOT,
+        capture_output=True,
+        check=False,
+    )
+
+
+class ResidencyImplementationBaseScoutTest(unittest.TestCase):
+    def test_report_is_the_exact_source_bound_scout_contract(self) -> None:
+        payload = json.loads(REPORT.read_text(encoding="utf-8"))
+
+        self.assertEqual(
+            set(payload),
+            {
+                "implementation_base_commit",
+                "implementation_base_tree",
+                "inputs",
+                "routing_helper_introduction_commit",
+                "schema",
+                "source_facts",
+                "source_seam_dispositions",
+                "stable_release_commit",
+                "stable_release_tag",
+            },
+        )
+        self.assertEqual(payload["schema"], "portable_residency_stable_source_scout/v1")
+        self.assertEqual(payload["implementation_base_commit"], BASE_COMMIT)
+        self.assertEqual(payload["implementation_base_tree"], BASE_TREE)
+        self.assertEqual(payload["stable_release_commit"], STABLE_COMMIT)
+        self.assertEqual(payload["stable_release_tag"], "v11.6.0")
+        self.assertEqual(
+            payload["routing_helper_introduction_commit"], ROUTING_HELPER_COMMIT
+        )
+
+        self.assertEqual(_git("rev-parse", f"{BASE_COMMIT}^{{tree}}").returncode, 0)
+        self.assertEqual(
+            _git("rev-parse", f"{BASE_COMMIT}^{{tree}}").stdout.decode().strip(),
+            BASE_TREE,
+        )
+        self.assertEqual(
+            _git("merge-base", "--is-ancestor", STABLE_COMMIT, BASE_COMMIT).returncode,
+            0,
+        )
+        self.assertEqual(
+            _git(
+                "merge-base",
+                "--is-ancestor",
+                ROUTING_HELPER_COMMIT,
+                BASE_COMMIT,
+            ).returncode,
+            0,
+        )
+
+        inputs = payload["inputs"]
+        self.assertEqual(len(inputs), len(EXPECTED_INPUTS))
+        self.assertEqual(
+            {item["path"]: item["sha256"] for item in inputs}, EXPECTED_INPUTS
+        )
+        blobs: dict[str, bytes] = {}
+        for source_path, expected_digest in EXPECTED_INPUTS.items():
+            result = _git("show", f"{BASE_COMMIT}:{source_path}")
+            self.assertEqual(result.returncode, 0, result.stderr.decode())
+            blobs[source_path] = result.stdout
+            self.assertEqual(hashlib.sha256(result.stdout).hexdigest(), expected_digest)
+
+        rows = payload["source_seam_dispositions"]
+        self.assertEqual(len(rows), len(EXPECTED_SEAMS))
+        actual_seams = {
+            row["id"]: (row["disposition"], row["path"], row["symbol"]) for row in rows
+        }
+        self.assertEqual(actual_seams, EXPECTED_SEAMS)
+        for row in rows:
+            self.assertEqual(
+                set(row),
+                {"id", "disposition", "path", "symbol", "note"},
+            )
+            self.assertTrue(row["note"])
+            self.assertIn(row["symbol"].encode(), blobs[row["path"]])
+
+        facts = payload["source_facts"]
+        self.assertEqual(len(facts), len(EXPECTED_SOURCE_FACTS))
+        actual_facts = {fact["id"]: (fact["path"], fact["symbol"]) for fact in facts}
+        self.assertEqual(actual_facts, EXPECTED_SOURCE_FACTS)
+        for fact in facts:
+            self.assertEqual(set(fact), {"id", "path", "symbol", "note"})
+            self.assertTrue(fact["note"])
+            self.assertIn(fact["symbol"].encode(), blobs[fact["path"]])
+
